platform :ios, '16.0'

require_relative '../node_modules/react-native/scripts/react_native_pods'

target 'ServicePanda' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :fabric_enabled => false,
    :new_arch_enabled => false,
    :hermes_enabled => true
  )

  

  # Add any custom native pods below this line
  pod 'OneSignal', '>= 3.0.0', '< 4.0'

  post_install do |installer|
    # Set environment variables to disable new architecture
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['RCT_NEW_ARCH_ENABLED'] = '0'
        config.build_settings['RCT_FABRIC_ENABLED'] = '0'
        config.build_settings['RCT_CODEGEN_ENABLED'] = '0'
      end
    end
    
    # Fix for RCT-Folly build issues
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # Fix for RCT-Folly
        if target.name == 'RCT-Folly'
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'FOLLY_NO_CONFIG=1'
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'FOLLY_MOBILE=1'
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'FOLLY_USE_LIBCPP=1'
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'FOLLY_HAVE_LIBGFLAGS=0'
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'FOLLY_HAVE_LIBJEMALLOC=0'
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'FOLLY_HAVE_PREADV=0'
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'FOLLY_HAVE_PWRITEV=0'
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'FOLLY_HAVE_TFO=0'
        end
        
        # Disable React-Codegen build but keep the target
        if target.name == 'React-Codegen'
          config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
          config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
          config.build_settings['CODE_SIGNING_IDENTITY'] = ''
          # Disable build but don't exclude architectures for archive
          config.build_settings['SKIP_INSTALL'] = 'YES'
        end
        
        # Remove codegen check scripts that cause build failures
        if target.name == 'React-Fabric'
          target.build_phases.each do |phase|
            if phase.is_a?(Xcodeproj::Project::Object::PBXShellScriptBuildPhase) && 
               phase.name && phase.name.include?('Check rncore')
              target.build_phases.delete(phase)
            end
          end
        end

        # Remove Hermes replacement script that breaks archive
        if target.name == 'hermes-engine'
          target.build_phases.each do |phase|
            if phase.is_a?(Xcodeproj::Project::Object::PBXShellScriptBuildPhase) &&
               phase.name && phase.name.include?('[Hermes]')
              target.build_phases.delete(phase)
            end
          end
          
          # Disable code signing for hermes-engine to prevent signing errors
          target.build_configurations.each do |config|
            config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
            config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
            config.build_settings['CODE_SIGNING_IDENTITY'] = ''
          end
        end
      end
    end
  end
end
